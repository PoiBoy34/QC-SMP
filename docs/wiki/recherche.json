---
layout: null
sitemap: false
---
[
{%- for a in site.wiki %}
  {
    "titre": {{ a.title | jsonify }},
    "categorie": {{ a.categorie | jsonify }},
    "url": {{ a.url | relative_url | jsonify }},
    "texte": {{ a.content | markdownify | strip_html | normalize_whitespace | truncatewords: 400 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
