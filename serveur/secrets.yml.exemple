# Copie ce fichier en secrets.yml et remplis-le : ./deploy.sh le lit tout seul.
# secrets.yml n'est jamais poussé sur GitHub (voir .gitignore).

# Jeton Cloudflare « Zone > DNS > Edit », limité à la zone du domaine :
# certificat HTTPS NetherNet + DNS dynamique vers l'IP de la maison.
cloudflare_api_token: ""

# Clé d'authentification Tailscale (facultative) : https://login.tailscale.com/admin/settings/keys
# → « Generate auth key », sans cocher « Reusable » ni « Ephemeral ».
# Sans clé : après le déploiement, ./outils.sh tailscale affiche un lien de connexion.
tailscale_authkey: ""
