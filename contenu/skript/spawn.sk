# Serveur spawn seulement : /spawn ramène au point de spawn, et la boussole ouvre le menu
# (pratique sur console, où taper une commande est pénible).

command /spawn:
	aliases: hub, lobby
	description: Retour au spawn
	trigger:
		teleport player to lieuSur(spawn of world "world")

# Le lobby est un carrefour : on y arrive toujours au point de spawn, debout sur le sol.
on join:
	wait 1 tick
	teleport player to lieuSur(spawn of world "world")
	set slot 4 of player's inventory to compass named "&9&lMenu LQDM &7(clic droit)"

on right click:
	uncolored name of player's tool is "Menu LQDM (clic droit)"
	cancel event
	make player execute command "menu"

on drop:
	uncolored name of event-item is "Menu LQDM (clic droit)"
	cancel event

on inventory click:
	event-item is set
	uncolored name of event-item is "Menu LQDM (clic droit)"
	cancel event

# Aucun mob ne naît au spawn (ni au hasard, ni avec le terrain). Ceux qu'un admin invoque
# (/summon, œuf) restent.
on spawn:
	spawn reason is natural or chunk generation
	cancel event
